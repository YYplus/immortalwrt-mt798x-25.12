#!/bin/sh
# Set the preferred hostname on a clean install.
# Keep an existing custom hostname on upgrades that preserve settings.
current_hostname="$(uci -q get system.@system[0].hostname)" || exit 0
[ "$current_hostname" = 'ImmortalWrt' ] || exit 0
uci set system.@system[0].hostname='G-DOCK' || exit 1
uci commit system
